rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             currentUser().data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      // Users can only create their own profile as a regular user.
      allow create: if (isSelf(userId) &&
                        request.resource.data.email == request.auth.token.email &&
                        request.resource.data.role == 'user')
                    || isAdmin();

      // Users may update profile fields, but cannot change role/email themselves.
      allow update: if (isSelf(userId) &&
                        request.resource.data.role == resource.data.role &&
                        request.resource.data.email == resource.data.email)
                    || isAdmin();

      allow delete: if isAdmin();
    }

    match /dog_assignments/{assignmentId} {
      allow read: if isAdmin() ||
                   (isSignedIn() && resource.data.trainerEmail == request.auth.token.email);
      allow create, update, delete: if isAdmin();
    }

    match /dogs/{dogId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /entries/{entryId} {
      allow create: if isSignedIn() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.userEmail == request.auth.token.email;
      allow read: if isSignedIn();
      allow update, delete: if isAdmin() ||
                            (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /settings/{userId} {
      allow read, write: if isSelf(userId) || isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
